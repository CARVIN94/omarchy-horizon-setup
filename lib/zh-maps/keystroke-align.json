      "replace": "title: \"向 Codex 提问\",\n               subtitle: \"Codex 桌面 · 新线程，提示词已就绪\", verb: \"打开 Codex\",",
      "count": 1
    },
    {
      "file": "core/AiTargets.js",
      "find": "subtitle: \"claude.ai · prompt ready to send\" + why, verb: \"Open Claude\",",
      "replace": "subtitle: \"claude.ai · 提示词已就绪\" + why, verb: \"打开 Claude\",",
      "count": 1
    },
    {
      "file": "core/AiTargets.js",
