      "replace": "title: \"向 ChatGPT 提问\",\n           subtitle: \"chatgpt.com · \" + (autoSend ? \"已发送你的提示词\" : \"提示词已就绪\") + why, verb: \"打开 ChatGPT\",",
      "count": 1
    },
    {
      "file": "core/AiTargets.js",
      "find": "title: \"Ask Cursor Agent\",\n             subtitle: \"Terminal · agent with your prompt\", verb: \"Open terminal\",",
